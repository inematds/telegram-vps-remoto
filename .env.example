# Telegram VPS remoto — copie para .env (o instalar.sh já faz isso) e deixe com chmod 600.
# Token que o @BotFather te deu (formato 123456789:ABC...). Nunca ponha em repo, log ou print.
TELEGRAM_BOT_TOKEN=
# IDs do Telegram que podem falar com o bot, separados por vírgula. Vazio = ninguém.
# Para descobrir o seu: mande /start ao bot e veja "recusado: from.id=..." no log. Depois: bash instalar.sh --dono <id>
DONOS=
# Modelo do Claude Code (assinatura): sonnet, haiku ou opus.
MODELO=sonnet
# Pasta onde a IA pode ler e onde os comandos aprovados rodam (padrão: area/ ao lado do bot.py).
# AREA=/home/<voce>/kits/telegram-vps-remoto/area
# Quanto tempo um pedido pendente vale, em segundos (padrão 600 = 10 min).
# PRAZO_OK_S=600
# Só para teste com o Telegram falso (ferramentas/telegram_falso.py):
# TELEGRAM_API=http://127.0.0.1:8081
